# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and must never be committed.

# SUPABASE
# Project URL + anon key: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: same page, "service_role" secret.
# Server-side only. Bypasses row-level security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Set to true to enable dev-only flows. Must be false in production.
NEXT_PUBLIC_DEV_MODE=false

# GOOGLE MAPS (Required for Places Autocomplete)
# Google Cloud Console > Credentials. Enable the Places API on the key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# TWILIO (Required for SMS Notifications)
# Console dashboard: Account SID + Auth Token. Trial accounts only send to verified numbers.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Test Credentials (used by dev-only test flows)
E2E_TEST_PASSWORD=
NEXT_PUBLIC_TEST_PASSWORD=
