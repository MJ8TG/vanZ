# Copy this file to mobile/.env and fill in the real values.
# mobile/.env is gitignored and must never be committed.
#
# EXPO_PUBLIC_* variables are embedded in the app bundle and readable by
# anyone who downloads the app. Never put a secret behind that prefix.

# SUPABASE
# Supabase dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# GOOGLE MAPS
# Google Cloud Console > Credentials. Restrict the key by app bundle id.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ANDROID_KEY=

# BACKEND
# Local dev: your machine's LAN IP so a physical device can reach it,
# e.g. http://192.168.1.10:3000 (localhost will not work from a device).
EXPO_PUBLIC_API_URL=
